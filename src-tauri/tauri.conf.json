{
  "productName": "Gearbox Relay",
  "version": "0.1.0",
  "identifier": "com.gearbox.relay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Gearbox Relay",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.ico", "icons/icon.icns", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": {
      "models/manifest.json": "models/"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["relay"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://relay.gearbox.io/api/v1/releases/latest"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRjk0OEUzMDgzQjU0RjMK"
    }
  }
}
