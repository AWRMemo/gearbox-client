{
  "manifest_version": 3,
  "name": "Relay Capture",
  "short_name": "Relay",
  "version": "1.0.0",
  "description": "Capture selected text to your Gearbox Relay knowledge base. On-device AI enriches highlights with tags and summaries.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/AWRMemo/gearbox-client",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Relay Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "capture-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Capture selected text to Relay"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
